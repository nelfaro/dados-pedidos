# Misma base Postgres que usa n8n con la credencial "API Postgres".
# Dentro de Easypanel usar el host interno del servicio, ej: postgres://usuario:clave@nombre-servicio:5432/base
DATABASE_URL=postgres://usuario:clave@host:5432/base

# Cadena larga y aleatoria (32+ caracteres) para firmar la sesion.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
